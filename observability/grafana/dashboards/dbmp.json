          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, acquired) (rate(dbmp_job_lock_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "acquired={{acquired}}",
          "refId": "A"
        }
      ]
    },
